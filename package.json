{
  "name": "jsversehub",
  "version": "1.0.0",
  "description": "Research-grade interactive JavaScript learning platform: galaxy-based navigation, spaced repetition, Bayesian knowledge tracing, and privacy-preserving learning analytics",
  "main": "public/index.html",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "start:dev": "NODE_ENV=development node server.js",
    "dev": "npm run dev:server",
    "dev:server": "concurrently \"npm run watch:css\" \"npm run watch:js\" \"npm run serve:local\"",
    "serve": "live-server public --port=3000 --entry-file=index.html",
    "serve:local": "live-server public --port=3000 --entry-file=index.html",
    "build": "npm run clean && npm run build:js",
    "build:css": "postcss src/styles/*.css --dir dist/styles --use autoprefixer cssnano",
    "build:js": "webpack --mode=production",
    "watch:css": "postcss src/styles/*.css --dir dist/styles --watch",
    "watch:js": "webpack --mode=development --watch",
    "test": "jest --maxWorkers=2",
    "test:watch": "jest --watch --maxWorkers=2",
    "test:coverage": "jest --coverage --maxWorkers=2",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" --max-warnings=0",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "lint:fix": "eslint \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" --fix && stylelint \"src/styles/**/*.css\" --fix",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "validate": "npm run lint && npm run format:check && npm run test:ci",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:assets": "copyfiles -u 1 \"public/**/*.{html,wav,woff2}\" dist/",
    "clean": "rimraf dist node_modules/.cache logs coverage",
    "deploy": "npm run build && npm run deploy:docker",
    "deploy:docker": "npm run build && docker build -t jsversehub:1.0.0 . && docker push jsversehub:1.0.0",
    "analyze": "webpack-bundle-analyzer dist/js/bundle.js",
    "docs": "jsdoc src/**/*.js -d docs/api",
    "lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "prepare": "husky"
  },
  "keywords": [
    "javascript",
    "learning",
    "education",
    "educational-technology",
    "gamification",
    "spaced-repetition",
    "knowledge-tracing",
    "learning-analytics",
    "interactive",
    "tutorial"
  ],
  "author": {
    "name": "Satvik Praveen",
    "email": "satvikpraveen707@gmail.com",
    "url": "https://github.com/SatvikPraveen"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SatvikPraveen/JSVerseHub.git"
  },
  "bugs": {
    "url": "https://github.com/SatvikPraveen/JSVerseHub/issues"
  },
  "homepage": "https://github.com/SatvikPraveen/JSVerseHub#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ],
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "autoprefixer": "^10.4.14",
    "babel-loader": "^9.1.0",
    "concurrently": "^8.2.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "cssnano": "^6.0.1",
    "eslint": "^8.42.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jsdoc": "^4.0.2",
    "lighthouse": "^10.4.0",
    "live-server": "^1.2.2",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.24",
    "postcss-cli": "^10.1.0",
    "postcss-loader": "^7.3.4",
    "prettier": "^2.8.8",
    "rimraf": "^5.0.1",
    "style-loader": "^3.3.3",
    "stylelint": "^15.7.0",
    "stylelint-config-standard": "^33.0.0",
    "webpack": "^5.88.0",
    "webpack-bundle-analyzer": "^4.9.0",
    "webpack-cli": "^5.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "sharp": "^0.33.5",
    "eslint-config-prettier": "^9.1.0"
  },
  "dependencies": {
    "core-js": "^3.31.0",
    "express": "^4.18.2"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/engine/**/*.js",
      "src/utils/**/*.js",
      "src/concepts/**/index.js",
      "!src/main.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "rules": {
      "selector-class-pattern": null,
      "no-descending-specificity": null,
      "custom-property-pattern": null,
      "keyframes-name-pattern": null,
      "font-family-name-quotes": "always-where-recommended",
      "color-hex-length": "short",
      "selector-pseudo-element-colon-notation": "double",
      "rule-empty-line-before": [
        "always-multi-line",
        {
          "except": [
            "first-nested"
          ],
          "ignore": [
            "after-comment"
          ]
        }
      ],
      "property-no-vendor-prefix": null,
      "selector-no-vendor-prefix": null,
      "value-no-vendor-prefix": null,
      "at-rule-no-vendor-prefix": null,
      "alpha-value-notation": null,
      "color-function-notation": null,
      "media-feature-range-notation": null,
      "declaration-block-no-redundant-longhand-properties": null,
      "shorthand-property-no-redundant-values": null,
      "number-max-precision": null,
      "no-duplicate-selectors": true
    }
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "browsers": [
              "> 1%",
              "last 2 versions",
              "not dead"
            ]
          },
          "useBuiltIns": "usage",
          "corejs": 3
        }
      ]
    ]
  }
}
