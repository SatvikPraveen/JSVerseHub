# JSVerseHub environment variables
#
# The application is a static single-page app served by server.js. Only the
# variables below are read; everything else (databases, caches, secrets) is
# intentionally absent because all learner data stays in the browser.

# Runtime mode: "production" serves dist/ (run `npm run build` first),
# anything else serves public/ for development.
NODE_ENV=development

# Port for server.js
PORT=3000
